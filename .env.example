# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
#   Windows : copy .env.example .env
#   macOS / Linux : cp .env.example .env
# .env 는 형상관리에 올리지 않는다. 키가 커밋되면 폐기하고 다시 발급받는다.

# SSAFY GMS 키 (https://gms.ssafy.io/web/)
GMS_KEY=

# 위키백과 API 연락처 — 영문 이메일. 없으면 분당 10회로 제한된다.
WIKI_CONTACT=

# OpenDART 인증키 (https://opendart.fss.or.kr/) — 항목 구축 · 공시 수집
DART_API_KEY=

# 공공데이터포털 서비스키 (금융위원회_주식시세정보) — 시가총액 상위 종목 선정
# KRX CSV를 data/raw/ 에 직접 둘 경우 비워 둔다.
DATA_GO_KR_KEY=

# 모델 프로필: dev(전부 작은 모델) | final(답변 생성만 상위 모델)
MODEL_PROFILE=dev
